document.addEventListener("DOMContentLoaded", function() {
    const twitch_iframe = document.getElementById("twitch-stream");
    const base_url = "https://embed.twitch.tv";
    const parent_domains = ["omen-valorant.webflow.io", "story-story.ai", "persephonepunch.github.io", "yslhp.github.io", "hyperx.com"];

    const current_hostname = window.location.hostname;
    if (parent_domains.indexOf(current_hostname) === -1) {
        parent_domains.push(current_hostname);
    }

    window.switchStream = function(channel) {
        let parent_query_string = "";
        for (const domain of parent_domains) {
            parent_query_string += `&parent=${domain}`;
        }

        twitch_iframe.src = `${base_url}?channel=${channel}${parent_query_string}`;
    }

    switchStream("valorant");
});
