<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | game11ty</title>
<meta name="description" content="{{ description }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}/article/">
<meta property="og:image" content="{{ site.url }}{{ ogImage }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogImageAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">
<meta name="twitter:image:alt" content="{{ ogImageAlt }}">
<link href="/favicon.ico" rel="icon" sizes="16x16 32x32 48x48">
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "TechArticle", "headline": title, "description": description, "url": site.url + "/article/", "dateModified": "2026-10-03", "image": { "@type": "ImageObject", "url": site.url + ogImage, "width": 1200, "height": 630, "description": ogImageAlt }, "encoding": [{ "@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": site.url + pdfUrl }, { "@type": "MediaObject", "encodingFormat": "text/markdown", "contentUrl": site.url + markdownUrl }] } | dump | safe }}</script>
<!-- CRM Sync reference-doc design system (one canonical source) -->
<link rel="stylesheet" href="https://persephonepunch.github.io/crm-sync-setup/doc.css">
<style>
/* Knowledge-base shell on top of doc.css: full width, fixed-scroll left nav. */
.docbar .inner{max-width:none}
.kbgrid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:56px;padding:0 40px}
.kbnav{position:sticky;top:46px;align-self:start;height:calc(100vh - 46px);overflow-y:auto;
  padding:40px 16px 40px 0;border-right:1px solid var(--g2);overscroll-behavior:contain}
.kbnav .label{font:600 11px/1 var(--mono);letter-spacing:.3em;text-transform:uppercase;color:var(--g5);margin:0 0 14px}
.kbnav a{display:block;color:var(--g5);text-decoration:none;font:400 14px/1.35 var(--sans);
  padding:7px 10px 7px 12px;border-left:2px solid transparent}
.kbnav a:hover{color:var(--ink);background:var(--g1)}
.kbnav a.sub{font-size:13px;padding-left:26px}
.kbnav a.on{color:var(--ink);border-left-color:var(--cyan);background:var(--g1);font-weight:600}
.kbnav .files{margin-top:22px;padding-top:16px;border-top:1px solid var(--g2)}
.kbnav .files a{font:600 11px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink);padding:9px 12px}
.kbgrid .wrap{max-width:none;margin:0;padding:48px 0 104px}
.doc section{scroll-margin-top:60px}
.doc h2,.doc h3{scroll-margin-top:60px}
.docfoot{max-width:none}
.hero-fig{margin:28px 0 0}
.hero-fig img{display:block;width:100%;height:auto;border:1px solid var(--g3);background:var(--paper)}
.hero-fig figcaption{margin-top:8px;font:12px/1.5 var(--mono);letter-spacing:.04em;color:var(--g5)}
.hero-fig figcaption a{color:var(--g5)}
.hero .summary{max-width:none}
@media (max-width:1000px){
  .kbgrid{grid-template-columns:minmax(0,1fr);padding:0 20px;gap:0}
  .kbnav{position:static;height:auto;max-height:300px;border-right:0;border-bottom:1px solid var(--g2);padding:24px 0}
}
</style>
</head>
<body>
<nav class="docbar" aria-label="Document"><div class="inner">
  <a href="/">&larr; game11ty</a>
  <a href="/rights/">Rights</a>
  <span class="spacer"></span>
  <a class="dl" href="{{ pdfUrl }}" download><svg viewBox="0 0 24 24"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14"/></svg>PDF</a>
  <a class="dl" href="{{ markdownUrl }}" download><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M7 15V9l2.5 3L12 9v6M17 9v6m0 0l-2-2m2 2l2-2"/></svg>Markdown</a>
  <a href="{{ sourceUrl }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>Source</a>
</div></nav>
<div class="kbgrid">
  <aside class="kbnav" aria-label="Contents">
    <p class="label">Contents</p>
    <!--kb-toc-->
    <div class="files">
      <a href="{{ pdfUrl }}" download>Download the PDF</a>
      <a href="{{ markdownUrl }}" download>Markdown</a>
      <a href="{{ sourceUrl }}" target="_blank" rel="noopener">Source on GitHub</a>
    </div>
  </aside>
  <div class="wrap">
    <header class="hero">
      <span class="kicker">{{ kicker }}</span>
      <h1>{{ title }}</h1>
      <figure class="hero-fig">
        <a href="{{ heroImage }}"><img src="{{ heroImage }}" width="1600" height="900" alt="{{ ogImageAlt }}" fetchpriority="high"></a>
        <figcaption>The build board behind this article. <a href="{{ pdfUrl }}" download>Download the full-resolution PDF</a>.</figcaption>
      </figure>
      <p class="sub summary"><b>Summary.</b> {{ summary }}</p>
      <div class="meta"><span>Status: <b>{{ status }}</b></span></div>
      <div class="meta"><span>Scope: <b>{{ scope }}</b></span></div>
      <div class="meta"><span>Updated <b>2026-10-03</b></span><span><a href="{{ pdfUrl }}" download>Download the PDF</a> (8.9 MB)</span><span><a href="{{ markdownUrl }}" download>Markdown</a></span><span><a href="{{ sourceUrl }}" target="_blank" rel="noopener">GitHub source</a></span></div>
    </header>
    <article class="doc">
{{ content | safe }}
    </article>
  </div>
</div>
<footer class="docfoot"><span>game11ty · Knowledge base · Demonstration rights metadata for agencies</span><span><a href="/rights/">Rights</a> · <a href="{{ sourceUrl }}" target="_blank" rel="noopener">Source</a></span></footer>
<script>
// Highlight the section in view in the fixed left nav.
(() => {
  const links = [...document.querySelectorAll('.kbnav a[href^="#"]')]
  const heads = [...document.querySelectorAll('.doc h2[id], .doc h3[id]')]
  let current
  const update = () => {
    let h = heads[0]
    for (const x of heads) { if (x.getBoundingClientRect().top < 120) h = x; else break }
    if (h === current) return
    current = h
    links.forEach(a => a.classList.toggle('on', a.hash === '#' + h.id))
    const on = links.find(a => a.hash === '#' + h.id)
    if (on) on.scrollIntoView({ block: 'nearest' })
  }
  addEventListener('scroll', update, { passive: true })
  update()
})()
</script>
</body>
</html>
