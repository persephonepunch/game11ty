<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="article">
  <meta property="og:image" content="{{ site.url }}/docs/pipeline-diagram.png">
  <meta property="og:image:alt" content="Pipeline diagram: Webflow site to sync.py to postsync.py to Eleventy build to GitHub Pages">
  <link href="/favicon.ico" rel="icon" sizes="16x16 32x32 48x48">
  <style>
    :root { --bg:#fff; --fg:#1a1a1a; --muted:#5c5c5c; --rule:#e2e2e2; --code:#f5f5f4; --accent:#d62839; }
    @media (prefers-color-scheme: dark) { :root { --bg:#121212; --fg:#ececec; --muted:#a3a3a3; --rule:#2e2e2e; --code:#1d1d1d; --accent:#ff4655; } }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--fg); font:17px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    main { max-width:1400px; margin:0 auto; padding:56px 32px 96px; }
    h1 { font-size:2.4rem; line-height:1.2; margin:0 0 8px; }
    h2 { font-size:1.6rem; margin:56px 0 12px; padding-top:16px; border-top:1px solid var(--rule); }
    h3 { font-size:1.2rem; margin:36px 0 8px; }
    p, li { max-width:110ch; }
    a { color:var(--accent); }
    code { font:0.88em/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; background:var(--code); padding:1px 5px; border-radius:4px; }
    pre { background:var(--code); padding:16px 20px; border-radius:8px; overflow-x:auto; }
    pre code { background:none; padding:0; }
    table { width:100%; border-collapse:collapse; margin:16px 0 24px; font-size:15px; display:block; overflow-x:auto; }
    @media (min-width:900px) { table { display:table; } }
    th, td { text-align:left; vertical-align:top; padding:10px 14px; border-bottom:1px solid var(--rule); }
    th { font-weight:600; border-bottom:2px solid var(--fg); white-space:nowrap; }
    img { max-width:100%; height:auto; border-radius:8px; border:1px solid var(--rule); }
    ul { padding-left:1.4em; }
    .back { font-size:14px; color:var(--muted); }
    @media (max-width:600px) { main { padding:32px 16px 64px; } h1 { font-size:1.8rem; } }
  </style>
</head>
<body>
<main>
  <p class="back"><a href="/">game11ty</a> · <a href="/rights/">Rights</a> · <a href="/docs/gamestreaming-xmpdata.pdf">PDF board</a></p>
  {{ content | safe }}
</main>
</body>
</html>
