  <link href="/assets/6ac115594a913f6358c9c466_favicon256.png" media="(prefers-color-scheme: dark)" rel="icon" sizes="32x32" type="image/png"/>
  <link href="/assets/6ac115599654c6e22923dd8b_favicon256.png" rel="icon" sizes="48x48" type="image/png"/>
